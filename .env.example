# Used by netlify/functions/wit-lead.js — copy to .env for local `netlify dev` testing.
# .env is gitignored; never commit real values.

# Domain rndCRM gave you in Settings -> Websites -> Snippet (src="https://<CRM_DOMAIN>/wit.js")
CRM_WIT_DOMAIN=https://crm.bizzbuzzcreations.com

# data-tracking-id from the same Snippet panel (not secret, also hardcoded in each page's <script> tag)
CRM_WIT_TRACKING_ID=wit_92224e5ddb4a5064b5677653

# From "New Secret" on the site's card in rndCRM — secret, set via Netlify dashboard in production
CRM_WIT_SECRET=
